+        with:
+          path: ${{ env.AYA_NATIVE_ASSET_CACHE }}
+          key: ${{ steps.pins.outputs.key }}
+      - name: Record tested source and exact model publisher metadata
+        if: always()
+        shell: pwsh
+        run: |
+          @'
+          const fs=require('node:fs'),crypto=require('node:crypto'),evidence=process.env.AYA_EVIDENCE_DIRECTORY,reportFile=name=>require('node:path').join(evidence,name);
+          fs.mkdirSync(evidence,{recursive:true});
+          const names=['electron/aya-local.cjs','electron/aya/managed-runtime.cjs','electron/aya/core.cjs','electron/aya/memory-task.cjs','electron/aya/dialogue.cjs','electron/aya/agent.cjs','scripts/verify-aya-native.cjs','scripts/run-windows-aya-native.cjs'];
+          const hashes=Object.fromEntries(names.map(name=>[name,crypto.createHash('sha256').update(fs.readFileSync(name)).digest('hex')]));
+          fs.writeFileSync(reportFile('source-info.json'),JSON.stringify({testedCommit:process.env.GITHUB_SHA,runnerOS:process.platform,node:process.version,runId:process.env.GITHUB_RUN_ID,sourceHashes:hashes},null,2)+'\n');
+          (async()=>{try{const r=await fetch('https://huggingface.co/api/models/unsloth/Qwen3.5-4B-GGUF/revision/e87f176479d0855a907a41277aca2f8ee7a09523?blobs=true',{signal:AbortSignal.timeout(20000)});const data=r.ok?await r.json():null;fs.writeFileSync(reportFile('publisher-model-metadata.json'),JSON.stringify({httpStatus:r.status,revision:data?.sha,files:data?.siblings?.filter(f=>f.rfilename.endsWith('.gguf')).map(f=>({name:f.rfilename,lfs:f.lfs}))},null,2)+'\n');}catch{fs.writeFileSync(reportFile('publisher-model-metadata.json'),JSON.stringify({error:'OFFICIAL_METADATA_UNAVAILABLE'})+'\n');}})();
+          (async()=>{const sourceURL='https://huggingface.co/unsloth/Qwen3.5-4B-GGUF/resolve/e87f176479d0855a907a41277aca2f8ee7a09523/README.md';try{const r=await fetch(sourceURL,{signal:AbortSignal.timeout(20000)});const content=r.ok?await r.text():'';fs.writeFileSync(reportFile('publisher-model-card-proof.json'),JSON.stringify({sourceURL,httpStatus:r.status,bytes:Buffer.byteLength(content),sha256:crypto.createHash('sha256').update(content).digest('hex'),relevantLines:content.split('\n').filter(line=>/temperature|top_p|top_k|min_p|greedy|best practices|non-thinking/i.test(line))},null,2)+'\n');}catch{fs.writeFileSync(reportFile('publisher-model-card-proof.json'),JSON.stringify({sourceURL,error:'OFFICIAL_MODELCARD_UNAVAILABLE'})+'\n');}})();
+          '@ | node
+      - name: Commit only diagnostic reports to isolated branch
+        if: always()
+        shell: pwsh
+        run: |
+          git config user.name 'DentAYA native validation'
+          git config user.email 'github-actions[bot]@users.noreply.github.com'
+          $allowed = @('windows-native-result.json','native-inference-report.json','native-acceptance.txt','source-info.json','publisher-model-metadata.json','official-4b-metadata.json','publisher-model-card-proof.json','official-instruct-2507-metadata.json')
