# Browser-safe application settings
NEXT_PUBLIC_DENTAYA_RELEASE_CHANNEL=staging
NEXT_PUBLIC_DENTAYA_BUILD_LABEL=DentAYA RC59

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Google Maps Embed API key for the courier route panel.
# If empty, the panel keeps its built-in route fallback and Google Maps handoff.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional server-side AYA connection. Leave disabled until a server secret is set.
DENTAYA_AI_CLOUD_ENABLED=false
DENTAYA_AI_MODEL=gpt-5.4
# OPENAI_API_KEY=

# Never expose service-role or OpenAI secrets with a NEXT_PUBLIC_ prefix.

# Server-only key for Google Maps Geocoding API. Do not expose with NEXT_PUBLIC_.
GOOGLE_MAPS_GEOCODING_KEY=

# Server-only Google Maps Routes API key for traffic-aware ETA/distance.
GOOGLE_MAPS_ROUTES_KEY=

# Server only. Required for public pre-registration writes.
SUPABASE_SERVICE_ROLE_KEY=
